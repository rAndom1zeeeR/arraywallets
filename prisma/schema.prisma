// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== СПРАВОЧНИКИ ====================

model ChainAddress {
  id          String   @id @default(uuid()) @db.Uuid
  /// Canonical raw TON address (`workchain:hex`). Normalize with `toRawTonAddress()` before write.
  rawAddress  String   @unique @map("raw_address")
  name        String?
  isScam      Boolean  @default(false) @map("is_scam")
  icon        String?
  isWallet    Boolean  @default(false) @map("is_wallet")

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @updatedAt @map("last_seen_at") @db.Timestamptz(3)

  eventsCount  Int @default(0) @map("events_count")
  actionsCount Int @default(0) @map("actions_count")

  fromActions ChainAction[] @relation("ActionFrom")
  toActions   ChainAction[] @relation("ActionTo")

  @@map("chain_address")
}

model ChainJetton {
  id          String   @id @default(uuid()) @db.Uuid
  /// Jetton master contract address in raw `workchain:hex` form.
  address     String   @unique
  name        String
  symbol      String
  decimals    Int
  image       String?
  /// Matches TON API `JettonVerificationType`.
  verification ChainJettonVerification @default(NONE)
  score       Int      @default(0)

  /// TonAPI `TokenRates.prices` (display only, not for trading).
  priceUsd       Decimal?  @map("price_usd") @db.Decimal(36, 18)
  priceTon       Decimal?  @map("price_ton") @db.Decimal(36, 18)
  diff24hUsd     String?   @map("diff_24h_usd")
  diff7dUsd      String?   @map("diff_7d_usd")
  diff30dUsd     String?   @map("diff_30d_usd")
  priceUpdatedAt DateTime? @map("price_updated_at") @db.Timestamptz(3)

  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)

  actions     ChainAction[] @relation("ActionJetton")
  actionsIn   ChainAction[] @relation("ActionJettonIn")
  actionsOut  ChainAction[] @relation("ActionJettonOut")
  walletPnl   ChainWalletPnl[]

  @@index([address])
  @@index([symbol])
  @@index([verification])
  @@map("chain_jetton")
}

/// TON API `JettonVerificationType` (tonapi.io).
enum ChainJettonVerification {
  NONE       @map("none")
  WHITELIST  @map("whitelist")
  GRAYLIST   @map("graylist")
  BLACKLIST  @map("blacklist")
}

// ==================== СОБЫТИЯ TON API ====================

model ChainEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tonEventId  String   @unique @map("ton_event_id")

  /// Wallet account address in raw `workchain:hex` form (never EQ/UQ). Use `toRawTonAddress()`.
  walletAddress String   @map("wallet_address")

  timestamp   DateTime @db.Timestamptz(3)
  lt          Decimal  @db.Decimal(78, 0)
  isScam      Boolean  @default(false) @map("is_scam")
  inProgress  Boolean  @default(false) @map("in_progress")
  extra       BigInt   @db.BigInt

  rawData     Json?    @map("raw_data")

  actions     ChainAction[]
  rawEvents   ChainRawEvent[]
  syncStates  ChainSyncState[] @relation("SyncLastEvent")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([walletAddress, timestamp])
  @@index([lt])
  @@index([tonEventId])
  @@index([createdAt])
  @@map("chain_event")
}

model ChainRawEvent {
  id          String   @id @default(uuid()) @db.Uuid

  tonEventId  String   @unique @map("ton_event_id")

  chainEventId String?   @map("chain_event_id") @db.Uuid
  chainEvent   ChainEvent? @relation(fields: [chainEventId], references: [id], onDelete: SetNull)

  /// Wallet account address in raw `workchain:hex` form. Use `toRawTonAddress()`.
  walletAddress String   @map("wallet_address")
  payload     Json

  fetchedAt   DateTime   @default(now()) @map("fetched_at") @db.Timestamptz(3)
  processedAt DateTime?  @map("processed_at") @db.Timestamptz(3)
  processError String?   @map("process_error")

  @@index([walletAddress])
  @@index([tonEventId])
  @@index([fetchedAt])
  @@map("chain_raw_event")
}

// ==================== ДЕЙСТВИЯ ====================

model ChainAction {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  event       ChainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Denormalized from `ChainEvent.walletAddress` for feed queries without join.
  walletAddress String @map("wallet_address")

  orderIndex  Int      @map("order_index")
  type        ChainActionType
  status      ChainActionStatus @default(SUCCESS)

  fromId      String?  @map("from_id") @db.Uuid
  from        ChainAddress? @relation("ActionFrom", fields: [fromId], references: [id], onDelete: Restrict)
  toId        String?  @map("to_id") @db.Uuid
  to          ChainAddress? @relation("ActionTo", fields: [toId], references: [id], onDelete: Restrict)

  direction   ChainActionDirection? @map("direction")

  amount      Decimal? @db.Decimal(78, 0)
  amountIn    Decimal? @map("amount_in") @db.Decimal(78, 0)
  amountOut   Decimal? @map("amount_out") @db.Decimal(78, 0)
  tonIn       Decimal? @map("ton_in") @db.Decimal(78, 0)
  tonOut      Decimal? @map("ton_out") @db.Decimal(78, 0)

  jettonId    String?  @map("jetton_id") @db.Uuid
  jetton      ChainJetton? @relation("ActionJetton", fields: [jettonId], references: [id])
  jettonInId  String?  @map("jetton_in_id") @db.Uuid
  jettonIn    ChainJetton? @relation("ActionJettonIn", fields: [jettonInId], references: [id])
  jettonOutId String?  @map("jetton_out_id") @db.Uuid
  jettonOut   ChainJetton? @relation("ActionJettonOut", fields: [jettonOutId], references: [id])

  metadata    Json?

  displayAmount   String? @map("display_amount")
  displayDetails  String? @map("display_details")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([eventId, orderIndex])
  @@index([eventId])
  @@index([fromId])
  @@index([toId])
  @@index([jettonId])
  @@index([walletAddress, createdAt(sort: Desc)])
  @@index([walletAddress, type, direction, createdAt(sort: Desc)])
  @@index([direction, type, createdAt(sort: Desc)])
  @@map("chain_action")
}

enum ChainActionType {
  TON_TRANSFER
  JETTON_TRANSFER
  FLAWED_JETTON_TRANSFER
  JETTON_SWAP
  INFERRED_SWAP
  JETTON_BURN
  JETTON_MINT
  SMART_CONTRACT_EXEC
  DEPOSIT_STAKE
  WITHDRAW_STAKE
  NFT_TRANSFER
  NFT_MINT
  NFT_SALE
  SUBSCRIBE
  UNSUBSCRIBE
  AUCTION_BID
  DOMAIN_RENEW
  UNKNOWN
}

enum ChainActionStatus {
  SUCCESS @map("success")
  FAILED  @map("failed")
  PENDING @map("pending")
}

enum ChainActionDirection {
  INCOMING   @map("incoming")
  OUTGOING   @map("outgoing")
  SELF       @map("self")
  UNKNOWN    @map("unknown")
}

// ==================== СИНХРОНИЗАЦИЯ ====================

model ChainSyncState {
  id          String   @id @default(uuid()) @db.Uuid
  /// Wallet account address in raw `workchain:hex` form. Use `toRawTonAddress()`.
  walletAddress String @unique @map("wallet_address")

  lastLt      Decimal? @map("last_lt") @db.Decimal(78, 0)
  lastTimestamp DateTime? @map("last_timestamp") @db.Timestamptz(3)
  /// Last processed TON API event id (hash). Not `ChainEvent.id` UUID.
  lastTonEventId String?  @map("last_ton_event_id")
  lastEvent      ChainEvent? @relation("SyncLastEvent", fields: [lastTonEventId], references: [tonEventId], onDelete: SetNull)

  status      ChainSyncStatus @default(IDLE)
  error       String?

  eventsSynced Int     @default(0) @map("events_synced")
  actionsSynced Int    @default(0) @map("actions_synced")
  /// True when TonAPI history is fully backfilled to genesis (no more `before_lt` pages).
  historyComplete Boolean @default(false) @map("history_complete")

  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@index([updatedAt])
  @@index([lastTonEventId])
  @@map("chain_sync_state")
}

enum ChainSyncStatus {
  IDLE       @map("idle")
  SYNCING    @map("syncing")
  PAUSED     @map("paused")
  ERROR      @map("error")
  COMPLETED  @map("completed")
}

// ==================== SWAP PNL (materialized) ====================

/// Per-wallet swap PnL: one row for TON, one for USDT, one per jetton (excluding USDT-like masters).
model ChainWalletPnl {
  id            String   @id @default(uuid()) @db.Uuid
  /// Wallet account address in raw `workchain:hex` form.
  walletAddress String   @map("wallet_address")
  assetKind     ChainWalletPnlAssetKind @map("asset_kind")
  /// Stable key: `ton`, `usdt`, or jetton master raw address (lowercase).
  assetKey      String   @map("asset_key")
  jettonId      String?  @map("jetton_id") @db.Uuid
  jetton        ChainJetton? @relation(fields: [jettonId], references: [id], onDelete: SetNull)
  /// Jetton decimals when `assetKind` is JETTON or USDT; null for TON.
  decimals      Int?
  spentRaw      Decimal  @map("spent_raw") @db.Decimal(78, 0)
  receivedRaw   Decimal  @map("received_raw") @db.Decimal(78, 0)
  netRaw        Decimal  @map("net_raw") @db.Decimal(78, 0)
  /// Total successful JETTON_SWAP count for the wallet (stored on the TON row only).
  swapCount     Int      @default(0) @map("swap_count")
  computedAt    DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@unique([walletAddress, assetKey])
  @@index([walletAddress])
  @@index([walletAddress, assetKind])
  @@index([jettonId])
  @@map("chain_wallet_pnl")
}

enum ChainWalletPnlAssetKind {
  TON    @map("ton")
  USDT   @map("usdt")
  JETTON @map("jetton")
}

// ==================== AUTH (Auth.js) ====================

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(3)
  image         String?
  /// Canonical raw TON wallet address (`workchain:hex`) for TON Connect sign-in.
  walletAddress String?   @unique @map("wallet_address")
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  refreshTokens AuthRefreshToken[]

  @@map("auth_user")
}

model AuthRefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_refresh_token")
}

model TonProofChallenge {
  id        String    @id @default(cuid())
  payload   String    @unique
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_ton_proof_challenge")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("auth_verification_token")
}
