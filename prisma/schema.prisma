// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== СПРАВОЧНИКИ ====================

model ChainAddress {
  id          String   @id @default(uuid()) @db.Uuid
  rawAddress  String   @unique @map("raw_address")
  name        String?
  isScam      Boolean  @default(false) @map("is_scam")
  icon        String?
  isWallet    Boolean  @default(false) @map("is_wallet")

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt @map("last_seen_at")

  // Счетчики для аналитики
  eventsCount  Int @default(0) @map("events_count")
  actionsCount Int @default(0) @map("actions_count")

  // Связи
  fromActions ChainAction[] @relation("ActionFrom")
  toActions   ChainAction[] @relation("ActionTo")

  @@index([rawAddress])
  @@map("chain_address")
}

model ChainJetton {
  id          String   @id @default(uuid()) @db.Uuid
  address     String   @unique
  name        String
  symbol      String
  decimals    Int
  image       String?
  verification String   @default("none")
  score       Int      @default(0)

  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  // Связи
  actions     ChainAction[] @relation("ActionJetton")
  actionsIn   ChainAction[] @relation("ActionJettonIn")
  actionsOut  ChainAction[] @relation("ActionJettonOut")

  @@index([address])
  @@index([symbol])
  @@map("chain_jetton")
}

// ==================== СОБЫТИЯ TON API ====================

model ChainEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tonEventId  String   @unique @map("ton_event_id")

  // Адрес аккаунта в формате TON (0:...)
  walletAddress String   @map("wallet_address")

  timestamp   DateTime
  lt          Decimal  @db.Decimal(78, 0)
  isScam      Boolean  @default(false) @map("is_scam")
  inProgress  Boolean  @default(false) @map("in_progress")
  extra       BigInt   @db.BigInt

  // Сырые данные для дебага/повторной обработки
  rawData     Json?    @map("raw_data")

  // Связи
  actions     ChainAction[]

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([walletAddress, timestamp])
  @@index([lt])
  @@index([tonEventId])
  @@index([createdAt])
  @@map("chain_event")
}

// Сырые ответы от TON API (для дебага и ре-обработки)
model ChainRawEvent {
  id          String   @id @default(uuid()) @db.Uuid

  // TON API event ID (hash string, not UUID)
  tonEventId  String   @unique @map("ton_event_id")

  // Optional link to processed ChainEvent
  chainEventId String?   @map("chain_event_id") @db.Uuid

  walletAddress String   @map("wallet_address")
  payload     Json       // Полный ответ от TON API

  fetchedAt   DateTime   @default(now()) @map("fetched_at")
  processedAt DateTime?  @map("processed_at")
  processError String?   @map("process_error")

  @@index([walletAddress])
  @@index([tonEventId])
  @@index([fetchedAt])
  @@map("chain_raw_event")
}

// ==================== ДЕЙСТВИЯ ====================

model ChainAction {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  event       ChainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  orderIndex  Int      @map("order_index")
  type        ChainActionType
  status      ChainActionStatus @default(success)

  // Адреса (нормализованы через ChainAddress)
  fromId      String?  @map("from_id") @db.Uuid
  from        ChainAddress? @relation("ActionFrom", fields: [fromId], references: [id])
  toId        String?  @map("to_id") @db.Uuid
  to          ChainAddress? @relation("ActionTo", fields: [toId], references: [id])

  // Направление для transfer-операций (относительно walletAddress из ChainEvent)
  direction   ChainActionDirection? @map("direction")

  // Суммы (в базовых единицах)
  amount      Decimal? @db.Decimal(78, 0)
  amountIn    Decimal? @map("amount_in") @db.Decimal(78, 0)
  amountOut   Decimal? @map("amount_out") @db.Decimal(78, 0)
  tonIn       Decimal? @map("ton_in") @db.Decimal(78, 0)
  tonOut      Decimal? @map("ton_out") @db.Decimal(78, 0)

  // Жетоны (нормализованы через ChainJetton)
  jettonId    String?  @map("jetton_id") @db.Uuid
  jetton      ChainJetton? @relation("ActionJetton", fields: [jettonId], references: [id])
  jettonInId  String?  @map("jetton_in_id") @db.Uuid
  jettonIn    ChainJetton? @relation("ActionJettonIn", fields: [jettonInId], references: [id])
  jettonOutId String?  @map("jetton_out_id") @db.Uuid
  jettonOut   ChainJetton? @relation("ActionJettonOut", fields: [jettonOutId], references: [id])

  // Детали в JSON (зависит от type):
  // - TON_TRANSFER: { comment?, encrypted?, refund? }
  // - JETTON_TRANSFER: { comment?, encrypted?, wallet: "0:..." }
  // - JETTON_SWAP: { dex: "stonfi", router: "0:..." }
  // - SMART_CONTRACT_EXEC: { operation: "NftTransfer", payload?, contract: "0:..." }
  // - DEPOSIT_STAKE: { poolName?, poolAddress: "0:...", implementation? }
  // - JETTON_BURN/JETTON_MINT: { wallet: "0:..." }
  metadata    Json?

  // UI-оптимизация (кэшированные строки для отображения)
  displayAmount   String? @map("display_amount")
  displayDetails  String? @map("display_details")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([eventId])
  @@index([type])
  @@index([fromId])
  @@index([toId])
  @@index([jettonId])
  @@index([direction])
  @@index([createdAt])
  @@map("chain_action")
}

enum ChainActionType {
  TON_TRANSFER
  JETTON_TRANSFER
  JETTON_SWAP
  JETTON_BURN
  JETTON_MINT
  SMART_CONTRACT_EXEC
  DEPOSIT_STAKE
  WITHDRAW_STAKE
  NFT_TRANSFER
  NFT_MINT
  NFT_SALE
  SUBSCRIBE
  UNSUBSCRIBE
  AUCTION_BID
  DOMAIN_RENEW
  UNKNOWN
}

enum ChainActionStatus {
  success
  failed
  pending
}

enum ChainActionDirection {
  INCOMING   @map("incoming")
  OUTGOING   @map("outgoing")
  SELF       @map("self")
  UNKNOWN    @map("unknown")
}

// ==================== СИНХРОНИЗАЦИЯ ====================

// Статус синхронизации по адресу кошелька
model ChainSyncState {
  id          String   @id @default(uuid()) @db.Uuid
  walletAddress String @unique @map("wallet_address")

  // Последний обработанный lt (для пагинации вперед)
  lastLt      Decimal? @map("last_lt") @db.Decimal(78, 0)
  lastTimestamp DateTime? @map("last_timestamp")
  lastEventId String?  @map("last_event_id")

  // Статус
  status      ChainSyncStatus @default(idle)
  error       String?

  // Статистика
  eventsSynced Int     @default(0) @map("events_synced")
  actionsSynced Int    @default(0) @map("actions_synced")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([updatedAt])
  @@map("chain_sync_state")
}

enum ChainSyncStatus {
  idle
  syncing
  paused
  error
  completed
}
