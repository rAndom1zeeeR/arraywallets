# PostgreSQL (Prisma)
DATABASE_URL=

# Auth.js — required in production (session/JWT). Recommended in dev for TON Connect sign-in.
# Generate: npx auth secret
AUTH_SECRET=

# Optional; defaults to request host when trustHost is enabled (Vercel sets VERCEL=1)
# AUTH_URL=http://localhost:3000

# OAuth (GitHub: https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# OAuth (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that receive ADMIN role on sign-in
AUTH_ADMIN_EMAILS=

# Comma-separated wallet addresses (raw workchain:hex) for ADMIN role
AUTH_ADMIN_WALLETS=

# Primary ton_proof domain (host only, default from NEXT_PUBLIC_APP_URL)
# AUTH_TON_CONNECT_DOMAIN=localhost:3000

# Extra allowed ton_proof domains (comma-separated hosts, optional)
AUTH_TON_PROOF_DOMAINS=

# Public app URL (manifest, ton_proof domain fallback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TonAPI base URL (public — safe for browser)
NEXT_PUBLIC_TONAPI_BASE_URL=

# TonAPI key (server only — never NEXT_PUBLIC_)
TONAPI_API_KEY=
